// StageKit Scene Shadow
//
// MaskedShadow  lays a (blurred) silhouette of the casting sources over the
//               scene's finished picture as a shadow or glow, kept off every
//               source that is not background (the mask): where a source
//               covers part of a pixel, only the rest of it is shadowed.
//               Writes straight alpha for the rest of OBS.
// Ring          the same, then a line round the casting sources, also kept
//               off the mask the same way.
// Outlined      the casting sources with their line round them, which is
//               what casts the shadow when there is a line (as in the
//               per-source filter, whose shadow comes from the outlined
//               picture).
// BoxRing       one source's line drawn as a shape round its box (the
//               line's own corners: rounded, cut, notched or scooped), for
//               Ring and Outlined to take in place of the line round the
//               source's own shape.
//
// A file of its own on purpose: should Direct3D refuse it, the per-source
// shadow (stagekit-shadow.effect) still loads, and Scene Shadow passes the
// scene through. Constant loop bounds, float(i), SampleLevel in the loop, no
// inout: what both OpenGL and Direct3D accept.

uniform float4x4 ViewProj;
uniform texture2d image;        // the scene as OBS drew it, premultiplied
uniform texture2d shadow;       // the casting sources' silhouette, softened (straight alpha)
uniform texture2d silhouette;   // the casting sources' silhouette, sharp
uniform texture2d mask;         // every source that is not background, as drawn (premultiplied)

uniform float2 out_size;        // the canvas in pixels
uniform float2 shadow_offset;   // pixels
uniform float4 shadow_color;    // straight alpha; a = opacity
uniform float shadow_gain;      // > 1 spreads the shadow outwards
uniform float shadow_picture;   // 1 = the shadow takes the sources' own colours
uniform float shadow_boost;     // extra colour and brightness for those colours
uniform float outline_width;    // pixels
uniform float4 outline_color;   // straight alpha; a = opacity
uniform float image_straight;   // 1: `image` holds straight alpha (a picture this file made)
uniform texture2d ring_shape;   // the lines drawn as shapes round the sources' boxes (BoxRing)
uniform float ring_box;         // 1: the line is ring_shape's, 0: round the sources' own shape
uniform float glow_intensity;   // 1 as it was; more makes the shadow or glow denser, never harder-edged
uniform float2 box_size;        // BoxRing: the sprite, in canvas pixels
uniform float4 box_rect;        // BoxRing: the source's box in it: x, y, width, height
uniform float corner_size;      // BoxRing: the line's outer corner size, in canvas pixels
uniform float corner_style;     // BoxRing: 0 round, 1 cut, 2 notch, 3 scoop
uniform float ring_strength;    // BoxRing: how much the source counts (a Morph part-way)

sampler_state linearClamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

// Signed distance to a box with its corners shaped (Corners & Edges' maths):
// negative inside.
float corner_distance(float2 p, float4 r4, float r, float style)
{
	float2 half_size = r4.zw * 0.5;
	float2 v = p - (r4.xy + half_size);
	r = min(r, min(half_size.x, half_size.y));
	float2 q = abs(v) - half_size;
	float box = max(q.x, q.y);
	float2 qr = q + float2(r, r);
	float rounded = length(max(qr, float2(0.0, 0.0))) + min(max(qr.x, qr.y), 0.0) - r;
	float cut = max(box, (q.x + q.y + r) * 0.70710678);
	float notch = max(box, min(qr.x, qr.y));
	float scoop = max(box, r - length(q));
	float d = rounded;
	d = lerp(d, cut, step(0.5, style));
	d = lerp(d, notch, step(1.5, style));
	d = lerp(d, scoop, step(2.5, style));
	return d;
}

// The line's outer corner, no larger than keeps the box's own (square)
// corner under the line: larger, the source's corner would show past it.
// (Round: 2 + sqrt(2) widths; cut: 2; notch: 1; scoop: sqrt(2).)
float line_corner(float r, float style)
{
	float most = lerp(3.41421356, 2.0, step(0.5, style));
	most = lerp(most, 1.0, step(1.5, style));
	most = lerp(most, 1.41421356, step(2.5, style));
	return min(r, outline_width * most);
}

// A soft-kneed density: 1 is the coverage as it is; more fills the soft tail
// in towards full without clipping it (no hard edge where it saturates).
float densified(float a, float k)
{
	return 1.0 - pow(max(1.0 - saturate(a), 0.0), max(k, 0.01));
}

// Half a level of noise, fixed to the pixel, so a soft tail stored in eight
// bits shows no steps.
float dither(float2 uv)
{
	float2 p = floor(uv * out_size);
	return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453) - 0.5;
}

float3 picture_color(float3 c, float boost)
{
	float gray = dot(c, float3(0.299, 0.587, 0.114));
	return saturate(lerp(float3(gray, gray, gray), c, 1.0 + boost) * (1.0 + boost * 0.5));
}

// OBS lays a source over what is under it in linear light, so the shadow is
// laid on the same way, or it would come out darker than the shadow the
// per-source filter draws. The pictures hold ordinary (sRGB) values.
float3 to_linear(float3 c)
{
	return lerp(c / 12.92, pow(max((c + 0.055) / 1.055, float3(0.0, 0.0, 0.0)), float3(2.4, 2.4, 2.4)),
		    step(float3(0.04045, 0.04045, 0.04045), c));
}

float3 to_srgb(float3 c)
{
	return lerp(c * 12.92,
		    1.055 * pow(max(c, float3(0.0, 0.0, 0.0)), float3(1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4)) - 0.055,
		    step(float3(0.0031308, 0.0031308, 0.0031308), c));
}

// The scene in linear light, premultiplied.
float4 scene_linear(float2 uv)
{
	float4 scene = image.Sample(linearClamp, uv);
	float3 straight_rgb = lerp(scene.rgb / max(scene.a, 0.00001), scene.rgb, image_straight);
	return float4(to_linear(straight_rgb) * scene.a, scene.a);
}

// The part of a pixel the sources do not cover is shadowed, and only that.
// At a source's smoothed edge (a glyph's, say) a pixel is partly source and
// partly what is under it; shadowing the whole pixel by the uncovered share
// (as up to beta174) left most of what is under it unshadowed, a thin bright
// line of background between the source and its shadow. The mask holds the
// sources as drawn (premultiplied, ordinary values), so their part of the
// pixel is known, and what is left of the scene's pixel is what is under them.
struct Split {
	float4 source; // the sources' part of the pixel: linear light, premultiplied
	float4 under;  // the rest
	float free;    // how much of the pixel the sources leave uncovered
};

Split split_at(float2 uv)
{
	float4 scene = scene_linear(uv);
	float4 m = mask.Sample(linearClamp, uv);
	Split s;
	s.free = 1.0 - m.a;
	float4 drawn = float4(to_linear(m.rgb / max(m.a, 0.00001)) * m.a, m.a);
	// (What is under them is at most the share they leave; where the mask's
	// colours differ from the scene's, the scene is kept as it is.)
	s.under = min(max(scene - drawn, float4(0.0, 0.0, 0.0, 0.0)), float4(s.free, s.free, s.free, s.free));
	s.source = scene - s.under;
	return s;
}

// What is under the sources with a colour laid over it, `amount` of the way,
// over the uncovered share only.
float4 laid_under(float4 under, float free, float3 color_srgb, float amount)
{
	return float4(under.rgb * (1.0 - amount) + to_linear(color_srgb) * amount * free,
		      under.a * (1.0 - amount) + amount * free);
}

// What is under the sources with the shadow laid on it: linear light,
// premultiplied.
float4 shadowed_under(float2 uv, Split s)
{
	float2 suv = uv - shadow_offset / out_size;
	float inside = step(0.0, suv.x) * step(suv.x, 1.0) * step(0.0, suv.y) * step(suv.y, 1.0);
	float4 thrown = shadow.Sample(linearClamp, suv);
	float sa = densified(thrown.a * shadow_gain, glow_intensity) * shadow_color.a * inside;
	float3 shade = lerp(shadow_color.rgb, picture_color(thrown.rgb, shadow_boost), shadow_picture);
	return laid_under(s.under, s.free, shade, sa);
}

// Back to ordinary values, with straight alpha, for the rest of OBS.
// (Dithered by just under half a level: a value that is a whole level
// stays as it is, one in between, as a soft shadow's tail is, is spread
// between its two levels, so the tail shows no steps.)
float4 finished(float4 c, float2 uv)
{
	return float4(to_srgb(c.rgb / max(c.a, 0.00001)) + dither(uv) * (0.9 / 255.0), c.a);
}

float4 PSMaskedShadow(VertData v_in) : TARGET
{
	Split s = split_at(v_in.uv);
	return finished(s.source + shadowed_under(v_in.uv, s), v_in.uv);
}

// How much of the line covers a pixel: round the casting sources' own shape
// (the most solid of them within the width), or the shapes round their boxes.
float line_reach(float2 uv)
{
	float reach = silhouette.Sample(linearClamp, uv).a;
	float2 step_uv = float2(outline_width, outline_width) / out_size;
	for (int i = 0; i < 24; i++) {
		float angle = float(i) * 0.26179939;
		float2 dir = float2(cos(angle), sin(angle)) * step_uv;
		float a = silhouette.SampleLevel(linearClamp, uv + dir, 0).a;
		float b = silhouette.SampleLevel(linearClamp, uv + dir * 0.75, 0).a;
		float e = silhouette.SampleLevel(linearClamp, uv + dir * 0.5, 0).a;
		float d = silhouette.SampleLevel(linearClamp, uv + dir * 0.25, 0).a;
		reach = max(reach, max(max(a, b), max(e, d)));
	}
	return lerp(reach, ring_shape.Sample(linearClamp, uv).a, ring_box);
}

float4 PSRing(VertData v_in) : TARGET
{
	Split s = split_at(v_in.uv);
	float4 under = shadowed_under(v_in.uv, s);
	float reach = line_reach(v_in.uv);
	return finished(s.source + laid_under(under, s.free, outline_color.rgb, reach * outline_color.a), v_in.uv);
}

// The casting sources with their line: premultiplied, as the silhouette.
float4 PSOutlined(VertData v_in) : TARGET
{
	float4 own = silhouette.Sample(linearClamp, v_in.uv);
	float la = line_reach(v_in.uv) * outline_color.a;
	return float4(own.rgb + outline_color.rgb * la * (1.0 - own.a), own.a + la * (1.0 - own.a));
}

// One source's line round its box: the box grown by the width, with the
// line's corners, less the box itself, so the line never lies inside the
// box.
float4 PSBoxRing(VertData v_in) : TARGET
{
	float2 p = v_in.uv * box_size;
	float4 outer = float4(box_rect.xy - float2(outline_width, outline_width),
			      box_rect.zw + float2(outline_width, outline_width) * 2.0);
	float d_out = corner_distance(p, outer, line_corner(corner_size, corner_style), corner_style);
	float d_in = corner_distance(p, box_rect, 0.0, corner_style);
	float a = saturate(0.5 - d_out) * saturate(0.5 + d_in) * ring_strength;
	return float4(a, a, a, a);
}

technique MaskedShadow
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMaskedShadow(v_in);
	}
}

technique Ring
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSRing(v_in);
	}
}

technique Outlined
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSOutlined(v_in);
	}
}

technique BoxRing
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBoxRing(v_in);
	}
}
