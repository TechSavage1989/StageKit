// StageKit Shadow & Backdrop
//
// Card     places the source inside a larger, padded picture, optionally on
//          a backdrop panel and with rounded corners. Output is premultiplied.
// Outline  draws a line around the card, in a colour or in the picture's
//          own colours. Output is premultiplied.
// Compose  slides a (blurred) copy of the card's alpha underneath as the
//          shadow and writes straight alpha for the rest of OBS.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d shadow;
uniform texture2d extended;      // the picture carried on past its edges, for an outline made from it

uniform float2 out_size;        // padded picture size in pixels
uniform float2 src_size;        // source size in pixels
uniform float2 pad;             // left / top padding in pixels
uniform float radius;           // corner radius in pixels
uniform float backdrop_on;
uniform float backdrop_pad;     // how far the panel extends past the source
uniform float4 backdrop_color;  // straight alpha

uniform float2 shadow_offset;   // pixels
uniform float4 shadow_color;    // straight alpha; a = opacity
uniform float shadow_gain;      // > 1 spreads the shadow outwards
uniform float hide_source;      // 1 = draw the shadow only
uniform float shadow_picture;   // 1 = the shadow takes the picture's own colours
uniform float shadow_boost;     // extra colour and brightness for a picture-coloured shadow

uniform float outline_width;    // pixels
uniform float4 outline_color;   // straight alpha; a = opacity
uniform float outline_picture;  // 1 = the line takes the picture's own colours
uniform float extend_mirror;    // 1 = past its edge the picture is mirrored, 0 = its edge is stretched

sampler_state linearClamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

// Anti-aliased coverage of a rounded rectangle.
float round_rect(float2 p, float2 center, float2 half_size, float r)
{
	float rr = min(r, min(half_size.x, half_size.y));
	float2 q = abs(p - center) - half_size + float2(rr, rr);
	float d = length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - rr;
	return saturate(0.5 - d);
}

float4 PSCard(VertData v_in) : TARGET
{
	float2 p = v_in.uv * out_size;
	float2 center = pad + src_size * 0.5;

	float2 suv = (p - pad) / src_size;
	float inside = step(0.0, suv.x) * step(suv.x, 1.0) * step(0.0, suv.y) * step(suv.y, 1.0);
	float4 c = image.Sample(linearClamp, saturate(suv));
	float ca = c.a * inside * round_rect(p, center, src_size * 0.5, radius);

	float ba = backdrop_on * backdrop_color.a *
		   round_rect(p, center, src_size * 0.5 + float2(backdrop_pad, backdrop_pad), radius + backdrop_pad);

	float3 rgb = c.rgb * ca + backdrop_color.rgb * ba * (1.0 - ca);
	float a = ca + ba * (1.0 - ca);
	return float4(rgb, a);
}

// The picture's own colour, made richer and brighter by boost.
float3 picture_color(float3 c, float boost)
{
	float gray = dot(c, float3(0.299, 0.587, 0.114));
	return saturate(lerp(float3(gray, gray, gray), c, 1.0 + boost) * (1.0 + boost * 0.5));
}

// The picture carried on past its own edges to fill the whole padded area:
// either mirrored at each edge or with its edge pixels stretched outwards.
float4 PSExtend(VertData v_in) : TARGET
{
	float2 suv = (v_in.uv * out_size - pad) / src_size;
	float2 mirrored = 1.0 - abs(1.0 - abs(suv));
	float2 at = saturate(lerp(suv, mirrored, extend_mirror));
	float4 c = image.Sample(linearClamp, at);
	return float4(c.rgb * c.a, c.a);
}

float4 PSOutline(VertData v_in) : TARGET
{
	float4 card = image.Sample(linearClamp, v_in.uv);
	// How close the card is: the most solid thing within the line's width.
	float reach = card.a;
	float2 step_uv = float2(outline_width, outline_width) / out_size;
	for (int i = 0; i < 24; i++) {
		float angle = float(i) * 0.26179939;
		float2 dir = float2(cos(angle), sin(angle)) * step_uv;
		float a = image.SampleLevel(linearClamp, v_in.uv + dir, 0).a;
		float b = image.SampleLevel(linearClamp, v_in.uv + dir * 0.75, 0).a;
		float c = image.SampleLevel(linearClamp, v_in.uv + dir * 0.5, 0).a;
		float d = image.SampleLevel(linearClamp, v_in.uv + dir * 0.25, 0).a;
		reach = max(reach, max(max(a, b), max(c, d)));
	}
	float4 own = extended.Sample(linearClamp, v_in.uv);
	float3 line_rgb = lerp(outline_color.rgb, own.rgb, outline_picture);
	float la = reach * outline_color.a * lerp(1.0, own.a, outline_picture);
	float3 rgb = card.rgb + line_rgb * la * (1.0 - card.a);
	float a_out = card.a + la * (1.0 - card.a);
	return float4(rgb, a_out);
}

float4 PSCompose(VertData v_in) : TARGET
{
	float4 card = image.Sample(linearClamp, v_in.uv) * (1.0 - hide_source);
	float2 suv = v_in.uv - shadow_offset / out_size;
	float inside = step(0.0, suv.x) * step(suv.x, 1.0) * step(0.0, suv.y) * step(suv.y, 1.0);
	// The softened copy comes back with straight alpha: its colours are the picture's.
	float4 thrown = shadow.Sample(linearClamp, suv);
	float sa = saturate(thrown.a * shadow_gain) * shadow_color.a * inside;
	float3 shade = lerp(shadow_color.rgb, picture_color(thrown.rgb, shadow_boost), shadow_picture);

	float3 rgb = card.rgb + shade * sa * (1.0 - card.a);
	float a = card.a + sa * (1.0 - card.a);
	return float4(rgb / max(a, 0.00001), a);
}

technique Card
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSCard(v_in);
	}
}

technique Extend
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSExtend(v_in);
	}
}

technique Outline
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSOutline(v_in);
	}
}

technique Compose
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSCompose(v_in);
	}
}
