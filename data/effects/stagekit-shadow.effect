// StageKit Shadow & Backdrop
//
// Card     places the source inside a larger, padded picture, optionally on
//          a backdrop panel and with rounded corners. Output is premultiplied.
// Outline  draws a line around the card, in a colour or in the picture's
//          own colours. Output is premultiplied.
// Compose  slides a (blurred) copy of the card's alpha underneath as the
//          shadow and writes straight alpha for the rest of OBS.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d shadow;
uniform texture2d extended;      // the picture carried on past its edges, for an outline made from it

uniform float2 out_size;        // padded picture size in pixels
uniform float2 src_size;        // source size in pixels
uniform float2 pad;             // left / top padding in pixels
uniform float radius;           // corner radius in pixels
uniform float backdrop_on;
uniform float backdrop_pad;     // how far the panel extends past the source
uniform float4 backdrop_color;  // straight alpha

uniform float2 shadow_offset;   // pixels
uniform float4 shadow_color;    // straight alpha; a = opacity
uniform float shadow_gain;      // > 1 spreads the shadow outwards
uniform float hide_source;      // 1 = draw the shadow only
uniform float shadow_picture;   // 1 = the shadow takes the picture's own colours
uniform float shadow_boost;     // extra colour and brightness for a picture-coloured shadow

uniform float outline_width;    // pixels
uniform float4 outline_color;   // straight alpha; a = opacity
uniform float outline_picture;  // 1 = the line takes the picture's own colours
uniform float extend_mirror;    // 1 = past its edge the picture is mirrored, 0 = its edge is stretched
uniform float outline_corners;  // 0 = round the picture's own shape; 1..4 = round its box, corners
                                // rounded, cut, notched or scooped
uniform float corner_size;      // the line's outer corners, in pixels
uniform float glow_intensity;   // 1 as it was; more fills the soft tail in, never harder-edged
uniform texture2d rect_tex;     // what shows of the source, x0 y0 x1 y1 in its pixels (the line goes round it)
uniform texture2d area_tex;     // the sum of the source's alpha (red), for how much of rect_tex it fills
uniform float rect_known;       // 1 rect_tex holds it, 0 the line goes round the whole source
uniform float design_kind;      // the line's design (OutlineDesign, by number): 0 solid
uniform float4 design_color2;   // the gradient's other end, the shimmer's highlight
uniform float design_dash;      // pixels
uniform float design_gap;       // pixels
uniform float design_phase;     // marching dashes: how far along, in dash-and-gap lengths (0..1)
uniform float design_turn;      // what travels round: how far round (0..1)
uniform float design_pulse;     // the pulse now: 1 whole
uniform texture2d halo_tex;     // neon: the line's shape, softened (alpha): its halo of light
uniform float4 halo_color;      // neon: the halo's colour, as bright as it goes; a = how much light (0: none)
uniform texture2d pattern_tex;   // a pattern fill: the pattern, drawn by stagekit-patterns.effect, over this picture
uniform float pattern_on;       // 1: the line's colour is pattern_tex's, 0: the design's own
uniform float out_linear;       // 1: Compose writes linear light (OBS draws in linear light)

sampler_state linearClamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

sampler_state pointClamp {
	Filter   = Point;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

// Anti-aliased coverage of a rounded rectangle.
float round_rect(float2 p, float2 center, float2 half_size, float r)
{
	float rr = min(r, min(half_size.x, half_size.y));
	float2 q = abs(p - center) - half_size + float2(rr, rr);
	float d = length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - rr;
	return saturate(0.5 - d);
}

float4 PSCard(VertData v_in) : TARGET
{
	float2 p = v_in.uv * out_size;
	float2 center = pad + src_size * 0.5;

	float2 suv = (p - pad) / src_size;
	float inside = step(0.0, suv.x) * step(suv.x, 1.0) * step(0.0, suv.y) * step(suv.y, 1.0);
	float4 c = image.Sample(linearClamp, saturate(suv));
	float ca = c.a * inside * round_rect(p, center, src_size * 0.5, radius);

	float ba = backdrop_on * backdrop_color.a *
		   round_rect(p, center, src_size * 0.5 + float2(backdrop_pad, backdrop_pad), radius + backdrop_pad);

	float3 rgb = c.rgb * ca + backdrop_color.rgb * ba * (1.0 - ca);
	float a = ca + ba * (1.0 - ca);
	return float4(rgb, a);
}

// Signed distance to a box with its corners shaped (Corners & Edges' maths):
// negative inside.
float corner_distance(float2 p, float4 r4, float r, float style)
{
	float2 half_size = r4.zw * 0.5;
	float2 v = p - (r4.xy + half_size);
	r = min(r, min(half_size.x, half_size.y));
	float2 q = abs(v) - half_size;
	float box = max(q.x, q.y);
	float2 qr = q + float2(r, r);
	float rounded = length(max(qr, float2(0.0, 0.0))) + min(max(qr.x, qr.y), 0.0) - r;
	float cut = max(box, (q.x + q.y + r) * 0.70710678);
	float notch = max(box, min(qr.x, qr.y));
	float scoop = max(box, r - length(q));
	float d = rounded;
	d = lerp(d, cut, step(0.5, style));
	d = lerp(d, notch, step(1.5, style));
	d = lerp(d, scoop, step(2.5, style));
	return d;
}

// The line's outer corner, no larger than keeps the box's own (square)
// corner under the line: larger, the source's corner would show past it.
// (Round: 2 + sqrt(2) widths; cut: 2; notch: 1; scoop: sqrt(2).)
float line_corner(float r, float style)
{
	float most = lerp(3.41421356, 2.0, step(0.5, style));
	most = lerp(most, 1.0, step(1.5, style));
	most = lerp(most, 1.41421356, step(2.5, style));
	return min(r, outline_width * most);
}

// ---- The line's design. `u` is how far along the border a point is and
// `total` the border's length (pixels); `x` runs across the line from 0 at
// the source to 1 at its outer edge and `x_out` the other way; `follows` is
// 1 for a line that follows a shape, where both are only known in quarter
// steps. Gives (how much of the line is there, what its colour goes by).
float is_design(float n)
{
	return step(n - 0.5, design_kind) * step(design_kind, n + 0.5);
}

float3 hue_rgb(float h)
{
	return saturate(abs(frac(float3(h, h + 0.6666667, h + 0.3333333)) * 6.0 - 3.0) - 1.0);
}

// Dashes along the border, a whole number of them round it.
float dash_cover(float u, float total, float dash, float gap, float phase)
{
	float period = max(dash + gap, 1.0);
	float count = max(floor(total / period + 0.5), 1.0);
	float per = total / count;
	float len = per * dash / period;
	// (Half a dash on: a box's corner, where the border starts, is the
	// middle of a dash.)
	float a = frac((u + len * 0.5) / per - phase + 1.0) * per;
	return saturate(saturate(min(a, len - a) + 0.5) + saturate(a - per + 0.5));
}

float2 design_at(float u, float total, float x, float x_out, float w, float follows)
{
	float third = w / 3.0;
	float two_box = saturate(saturate(third - x * w + 0.5) + saturate(third - x_out * w + 0.5));
	float two_follow = saturate(step(0.875, x_out) + step(x_out, 0.375));
	float two = two_box + (two_follow - two_box) * follows;

	float dashes = dash_cover(u, total, design_dash, design_gap, design_phase);

	float dot_period = max(w + design_gap, 1.0);
	float dot_count = max(floor(total / dot_period + 0.5), 1.0);
	float dot_per = total / dot_count;
	float2 from_dot = float2((frac(u / dot_per) - 0.5) * dot_per, (x - 0.5) * w);
	float dots_box = saturate(w * 0.5 - length(from_dot) + 0.5);
	float dots_follow = dash_cover(u, total, w, design_gap, 0.0);
	float dots = dots_box + (dots_follow - dots_box) * follows;

	// Neon: the whole line is the tube, brightest along its middle (its
	// halo of light is laid past the line, from halo_tex).
	float tube = saturate(1.0 - abs(2.0 * x - 1.0));

	float at = u / max(total, 1.0);
	float wave = 0.5 - 0.5 * cos(6.2831853 * (at - design_turn));
	float glint = pow(saturate(0.5 + 0.5 * cos(6.2831853 * (at - design_turn))), 24.0);
	float hue = frac(at - design_turn + 1.0);

	float there = 1.0 + (two - 1.0) * is_design(1.0) + (dashes - 1.0) * (is_design(2.0) + is_design(7.0)) +
		      (dots - 1.0) * is_design(3.0) +
		      (design_pulse - 1.0) * is_design(9.0);
	float k = wave * (is_design(4.0) + is_design(8.0)) + glint * is_design(10.0) + hue * is_design(11.0) +
		  tube * is_design(5.0);
	return float2(there, k);
}

// The line's colour from what design_at gave.
float3 design_rgb(float3 base, float k)
{
	float mixes = is_design(4.0) + is_design(8.0) + is_design(10.0);
	float neon = is_design(5.0);
	float rainbow = is_design(11.0);
	float3 two = base + (design_color2.rgb - base) * k;
	// (Neon's tube: the colour brightened, towards white only along the very
	// middle and by no more than the colour is bright, so it keeps its hue; a
	// black line gets a dim rim.)
	float top = max(base.r, max(base.g, base.b));
	float3 bright = saturate(base * (1.0 + 0.35 * k));
	float3 lit = bright + (float3(1.0, 1.0, 1.0) - bright) * (k * k * (0.25 + 0.35 * top));
	return base * (1.0 - mixes - neon - rainbow) + two * mixes + lit * neon + hue_rgb(k) * rainbow;
}

// How far along a box's border a point is, clockwise from its top left
// corner (x), and the border's length (y).
float2 along_box(float2 p, float4 box)
{
	float2 half_size = box.zw * 0.5;
	float2 v = p - (box.xy + half_size);
	float2 q = abs(v) - half_size;
	float top = clamp(v.x + half_size.x, 0.0, box.z);
	float right = box.z + clamp(v.y + half_size.y, 0.0, box.w);
	float bottom = box.z + box.w + clamp(half_size.x - v.x, 0.0, box.z);
	float left = 2.0 * box.z + box.w + clamp(half_size.y - v.y, 0.0, box.w);
	float tb = top + (bottom - top) * step(0.0, v.y);
	float lr = left + (right - left) * step(0.0, v.x);
	return float2(tb + (lr - tb) * step(q.y, q.x), max(2.0 * (box.z + box.w), 1.0));
}

// How far round a rectangle a point is, as seen from its middle (the same
// measure as along_box for a point on the rectangle; no angle is taken).
float2 around_middle(float2 p, float4 box)
{
	float2 half_size = max(box.zw * 0.5, float2(1.0, 1.0));
	float2 n = (p - (box.xy + box.zw * 0.5)) / half_size;
	float ax = max(abs(n.x), 0.0001);
	float ay = max(abs(n.y), 0.0001);
	float e = clamp(n.y / ax, -1.0, 1.0);
	float f = clamp(n.x / ay, -1.0, 1.0);
	float top = (f + 1.0) * half_size.x;
	float right = 2.0 * half_size.x + (e + 1.0) * half_size.y;
	float bottom = 2.0 * half_size.x + 2.0 * half_size.y + (1.0 - f) * half_size.x;
	float left = 4.0 * half_size.x + 2.0 * half_size.y + (1.0 - e) * half_size.y;
	float tb = top + (bottom - top) * step(0.0, n.y);
	float lr = left + (right - left) * step(0.0, n.x);
	return float2(tb + (lr - tb) * step(ay, ax), 4.0 * (half_size.x + half_size.y));
}

// The line as a shape round the box (the source, or its panel): the box
// grown by the width with the chosen corners, less the box itself.
struct BoxLine {
	float cover;  // the whole line
	float inner;  // a line inside the box instead, down to a hole with the line's corners
	float2 made;  // the design there (design_at)
	float4 about; // what a following line is measured round: what shows of the source
};

BoxLine box_line(float2 p)
{
	float grow = backdrop_on * backdrop_pad;
	float4 seen = rect_tex.Sample(pointClamp, float2(0.5, 0.5));
	float4 whole = float4(pad, src_size);
	float4 shown = float4(pad + seen.xy, seen.zw - seen.xy);
	float any = lerp(1.0, step(seen.x, seen.z - 0.5) * step(seen.y, seen.w - 0.5), rect_known);
	float4 part = whole * (1.0 - rect_known) + shown * rect_known;
	float4 box = float4(part.xy - float2(grow, grow), part.zw + float2(grow, grow) * 2.0);
	float4 outer = float4(box.xy - float2(outline_width, outline_width),
			      box.zw + float2(outline_width, outline_width) * 2.0);
	float style = outline_corners - 1.0;
	float d_out = corner_distance(p, outer, line_corner(corner_size, style), style);
	float d_in = corner_distance(p, box, 0.0, style);
	BoxLine result;
	result.cover = saturate(0.5 - d_out) * saturate(0.5 + d_in) * any;
	float2 along = along_box(p, box);
	float w = max(outline_width, 0.5);
	result.made = design_at(along.x, along.y, d_in / w, -d_out / w, w, 0.0);
	float4 hole = float4(box.xy + float2(outline_width, outline_width),
			     max(box.zw - float2(outline_width, outline_width) * 2.0, float2(0.0, 0.0)));
	result.inner = saturate(0.5 - d_in) * saturate(0.5 + corner_distance(p, hole, corner_size, style)) * any;
	result.about = part;
	return result;
}

// A soft-kneed density: 1 is the coverage as it is; more fills the soft tail
// in towards full without clipping it.
float densified(float a, float k)
{
	return 1.0 - pow(max(1.0 - saturate(a), 0.0), max(k, 0.01));
}

// The picture's own colour, made richer and brighter by boost.
float3 picture_color(float3 c, float boost)
{
	float gray = dot(c, float3(0.299, 0.587, 0.114));
	return saturate(lerp(float3(gray, gray, gray), c, 1.0 + boost) * (1.0 + boost * 0.5));
}

// The picture carried on past its own edges to fill the whole padded area:
// either mirrored at each edge or with its edge pixels stretched outwards.
float4 PSExtend(VertData v_in) : TARGET
{
	float2 suv = (v_in.uv * out_size - pad) / src_size;
	float2 mirrored = 1.0 - abs(1.0 - abs(suv));
	float2 at = saturate(lerp(suv, mirrored, extend_mirror));
	float4 c = image.Sample(linearClamp, at);
	return float4(c.rgb * c.a, c.a);
}

float4 PSOutline(VertData v_in) : TARGET
{
	float4 card = image.Sample(linearClamp, v_in.uv);
	// How close the card is: the most solid thing within the line's width.
	// (Kept by distance, a quarter of the width apart: together they say
	// how near the card is, for a design across the line.)
	float4 ring = float4(card.a, card.a, card.a, card.a);
	float2 step_uv = float2(outline_width, outline_width) / out_size;
	for (int i = 0; i < 24; i++) {
		float angle = float(i) * 0.26179939;
		float2 dir = float2(cos(angle), sin(angle)) * step_uv;
		float a = image.SampleLevel(linearClamp, v_in.uv + dir, 0).a;
		float b = image.SampleLevel(linearClamp, v_in.uv + dir * 0.75, 0).a;
		float c = image.SampleLevel(linearClamp, v_in.uv + dir * 0.5, 0).a;
		float d = image.SampleLevel(linearClamp, v_in.uv + dir * 0.25, 0).a;
		ring = max(ring, float4(a, b, c, d));
	}
	float reach = max(max(ring.x, ring.y), max(ring.z, ring.w));
	float nearness = (ring.x + ring.y + ring.z + ring.w) * 0.25;
	// A source filling under nine tenths of the rectangle that shows of it
	// (text, a logo, a shape) keeps the line that follows it.
	float4 seen = rect_tex.Sample(pointClamp, float2(0.5, 0.5));
	float rect_area = max((seen.z - seen.x) * (seen.w - seen.y), 1.0);
	float sparse = step(area_tex.Sample(pointClamp, float2(0.5, 0.5)).r, 0.9 * rect_area) * rect_known;
	float boxed = step(0.5, outline_corners) * (1.0 - sparse);
	float2 p = v_in.uv * out_size;
	BoxLine edge = box_line(p);
	reach = reach * (1.0 - boxed) + edge.cover * boxed;
	// The design: a box line's goes by its box; a line that follows a shape
	// goes by how far round the rectangle that shows of the source a point
	// is, as seen from its middle.
	float designed = step(0.5, design_kind);
	float2 around = around_middle(p, edge.about);
	float2 by_shape = design_at(around.x, around.y, 1.0 - nearness, nearness, max(outline_width, 0.5), 1.0);
	float2 made = by_shape * (1.0 - boxed) + edge.made * boxed;
	// (An inner line has no line outside the box.)
	float inner = edge.inner * boxed * is_design(6.0);
	float amount = reach * (1.0 - boxed * is_design(6.0));
	amount = amount * (1.0 - designed) + amount * made.x * designed;
	float4 own = extended.Sample(linearClamp, v_in.uv);
	// A pattern fill: the line is a window onto the pattern's picture.
	// (Times one and plus nothing while off: the other designs are as they were.)
	float3 pattern_rgb = pattern_tex.Sample(linearClamp, v_in.uv).rgb;
	float3 design_colour = design_rgb(outline_color.rgb, made.y * designed) * (1.0 - pattern_on) + pattern_rgb * pattern_on;
	float3 line_rgb = lerp(design_colour, own.rgb, outline_picture);
	float seen_through = outline_color.a * lerp(1.0, own.a, outline_picture);
	float la = amount * seen_through;
	float3 rgb = card.rgb + line_rgb * la * (1.0 - card.a);
	float a_out = card.a + la * (1.0 - card.a);
	float li = inner * seen_through;
	return float4(rgb * (1.0 - li) + line_rgb * li, a_out * (1.0 - li) + li);
}

float4 PSCompose(VertData v_in) : TARGET
{
	float4 card = image.Sample(linearClamp, v_in.uv) * (1.0 - hide_source);
	float2 suv = v_in.uv - shadow_offset / out_size;
	float inside = step(0.0, suv.x) * step(suv.x, 1.0) * step(0.0, suv.y) * step(suv.y, 1.0);
	// The softened copy comes back with straight alpha: its colours are the picture's.
	float4 thrown = shadow.Sample(linearClamp, suv);
	float sa = densified(thrown.a * shadow_gain, glow_intensity) * shadow_color.a * inside;
	float3 shade = lerp(shadow_color.rgb, picture_color(thrown.rgb, shadow_boost), shadow_picture);

	// Neon's halo: light past the line, over the shadow and under the card,
	// in its brightest colour with as much alpha as there is light, so it
	// adds to what is behind the source more than it covers it. (Times
	// nothing while there is none: every other design is as it was.)
	float halo = saturate(halo_tex.Sample(linearClamp, v_in.uv).a * 2.0);
	float ha = halo * halo * halo_color.a;
	float3 under_rgb = shade * sa * (1.0 - ha) + halo_color.rgb * ha;
	float under_a = sa + ha * (1.0 - sa);
	float3 rgb = card.rgb + under_rgb * (1.0 - card.a);
	float a = card.a + under_a * (1.0 - card.a);
	float3 straight = rgb / max(a, 0.00001);
	float3 lin = lerp(straight / 12.92, pow(max((straight + 0.055) / 1.055, float3(0.0, 0.0, 0.0)), float3(2.4, 2.4, 2.4)),
			  step(float3(0.04045, 0.04045, 0.04045), straight));
	return float4(lerp(straight, lin, out_linear), a);
}

technique Card
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSCard(v_in);
	}
}

technique Extend
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSExtend(v_in);
	}
}

technique Outline
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSOutline(v_in);
	}
}

technique Compose
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSCompose(v_in);
	}
}
