// StageKit: an Ambient Background's finished picture as an outline's fill.
// The picture is laid out for the line's own picture (moved, turned, sized,
// mirrored at its edges so there is never a seam or black) and lifted
// (Brightness, Saturation) so the line reads against the background it
// shows. A file of its own: should a compiler refuse it, only this fill
// goes (the line is then its outline colour).
// Raw (non-linear) colour values in and out, as the pattern fills'.

uniform float4x4 ViewProj;
uniform texture2d image;    // the background's picture
uniform float4 frame;       // the line's uv to the background's: a 2x2 matrix by rows
uniform float2 frame_shift; // Position, in uv
uniform float bright;       // 1 as it is
uniform float saturation;   // 1 as it is, 0 grey

sampler_state linearMirror {
	Filter   = Linear;
	AddressU = Mirror;
	AddressV = Mirror;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSFill(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	float2 d = v_in.uv - float2(0.5, 0.5) - frame_shift;
	vert_out.uv  = float2(0.5, 0.5) + float2(dot(d, frame.xy), dot(d, frame.zw));
	return vert_out;
}

float4 PSFill(VertData v_in) : TARGET
{
	float3 rgb = image.Sample(linearMirror, v_in.uv).rgb;
	float grey = dot(rgb, float3(0.2126, 0.7152, 0.0722));
	rgb = float3(grey, grey, grey) + (rgb - float3(grey, grey, grey)) * saturation;
	return float4(saturate(rgb * bright), 1.0);
}

technique Fill
{
	pass
	{
		vertex_shader = VSFill(v_in);
		pixel_shader  = PSFill(v_in);
	}
}
