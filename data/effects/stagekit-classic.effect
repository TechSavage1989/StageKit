uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d original;
uniform texture2d mask_image;
uniform float2 pixel_size;
uniform float2 uv_scale;
uniform float2 image_origin;
uniform float2 shadow_offset;
uniform float2 steps;
uniform float4 ink;
uniform float4 weights0;
uniform float4 weights1;
uniform float4 weights2;
uniform float4 weights3;
uniform int radius;
uniform float threshold;
uniform bool hide_image;
uniform bool hide_shadow;
uniform bool use_mask;
uniform bool invert_mask;

sampler_state linear_sampler { Filter = Linear; AddressU = Clamp; AddressV = Clamp; };
struct Vertex { float4 pos : POSITION; float2 uv : TEXCOORD0; };
Vertex vertex_main(Vertex v) { v.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); return v; }

float4 sample_inside(float2 uv)
{
	if (min(uv.x, uv.y) < 0.0 || max(uv.x, uv.y) > 1.0)
		return float4(0.0, 0.0, 0.0, 0.0);
	return image.Sample(linear_sampler, uv);
}

float4 shadow_ps(Vertex v) : TARGET
{
	float2 base_uv = v.uv * uv_scale - image_origin;
	float4 front = sample_inside(base_uv);
	if (hide_image) front = float4(0.0, 0.0, 0.0, 0.0);
	float4 back = hide_shadow ? float4(0.0, 0.0, 0.0, 0.0) : float4(ink.rgb, ink.a * sample_inside(base_uv - shadow_offset).a);
	return front * front.a + back * (1.0 - front.a);
}

float4 edge_ps(Vertex v) : TARGET
{
	float2 dx = float2(0.5 * pixel_size.x, 0.0);
	float2 dy = float2(0.0, 0.5 * pixel_size.y);
	float4 x_grad = image.Sample(linear_sampler, v.uv + dx) - image.Sample(linear_sampler, v.uv - dx);
	float4 y_grad = image.Sample(linear_sampler, v.uv + dy) - image.Sample(linear_sampler, v.uv - dy);
	float4 base = image.Sample(linear_sampler, v.uv);
	float alpha = step(threshold, sqrt(length(x_grad) + length(y_grad))) * ink.a;
	return float4(ink.rgb * alpha + base.rgb * (1.0 - alpha), ink.a * alpha + base.a * (1.0 - alpha));
}

float4 toon_ps(Vertex v) : TARGET
{
	float4 c = image.Sample(linear_sampler, v.uv);
	float3 rgb = c.rgb;
	float choose_green = step(rgb.b, rgb.g);
	float larger = lerp(rgb.b, rgb.g, choose_green);
	float smaller = lerp(rgb.g, rgb.b, choose_green);
	float choose_red = step(larger, rgb.r);
	float high = lerp(larger, rgb.r, choose_red);
	float other = lerp(rgb.r, larger, choose_red);
	float span = high - min(other, smaller);
	float offset = lerp(lerp(2.0 / 3.0, -1.0 / 3.0, choose_green), lerp(-1.0, 0.0, choose_green), choose_red);
	float hue = abs(offset + (other - smaller) / (6.0 * span + 1.0e-10));
	hue = round(hue * steps.x) / steps.x;
	float3 wheel = saturate(abs(frac(hue + float3(0.0, 0.6666667, 0.3333333)) * 6.0 - 3.0) - 1.0);
	float brightness = round(high * steps.y) / steps.y;
	return float4(brightness * lerp(float3(1.0, 1.0, 1.0), wheel, span / max(high, 0.00001)), c.a);
}

float weight(int i)
{
	if (i < 4) return weights0[i];
	if (i < 8) return weights1[i - 4];
	if (i < 12) return weights2[i - 8];
	return weights3[i - 12];
}

float4 convolve(float2 uv)
{
	float4 sum = image.Sample(linear_sampler, uv) * weights0.x;
	for (int i = 1; i <= radius; ++i) {
		float2 delta = float(i) * pixel_size;
		sum += weight(i) * (image.Sample(linear_sampler, uv - delta) + image.Sample(linear_sampler, uv + delta));
	}
	return sum;
}
float4 blur_ps(Vertex v) : TARGET { return convolve(v.uv); }
float4 mask_ps(Vertex v) : TARGET
{
	float4 blurred = convolve(v.uv);
	if (!use_mask) return blurred;
	float mask_value = mask_image.Sample(linear_sampler, v.uv).a;
	return lerp(original.Sample(linear_sampler, v.uv), blurred, invert_mask ? 1.0 - mask_value : mask_value);
}
technique Shadow { pass { vertex_shader = vertex_main(v); pixel_shader = shadow_ps(v); } }
technique Toon { pass { vertex_shader = vertex_main(v); pixel_shader = toon_ps(v); } }
technique Edges { pass { vertex_shader = vertex_main(v); pixel_shader = edge_ps(v); } }
technique Horizontal { pass { vertex_shader = vertex_main(v); pixel_shader = blur_ps(v); } }
technique Vertical { pass { vertex_shader = vertex_main(v); pixel_shader = mask_ps(v); } }
