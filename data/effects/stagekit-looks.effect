// StageKit looks: the mosaic's cell shapes, the trail over time, bloom and
// Ambient Background's darkest level (Lift).
//
// These are used by the Blur filter and by Ambient Background. They are a
// file of their own so that, should a graphics system refuse any of it, the
// older shader files still load and everything older keeps working.
//
// Mosaic and Temporal read and write straight (non-premultiplied) alpha and
// weight colour by alpha, like the blur passes. The bloom passes are for an
// opaque picture.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d image2;   // Temporal: what was drawn last time. BloomAdd: the light

uniform float2 texel;       // 1 / input texture size
uniform float2 size;        // input texture size in pixels
uniform float strength;     // mosaic: cell size in pixels
uniform float mix2;         // Temporal: how much of image2 stays
uniform float shape;        // mosaic: 0 square, 1 hexagon, 2 circle, 3 triangle, 4 voronoi, 5 rhomboid, 6 triakis
uniform float smoothing;    // mosaic: how far, in pixels, neighbouring cells run into each other
uniform float2 origin;      // mosaic: the point the pattern is laid out from, in pixels
uniform float2 turn;        // mosaic: cos and sin of the pattern's rotation
uniform float glass;        // mosaic: how much each cell looks like a piece of glass, 0..1
uniform float glass_style;  // mosaic: 0 a dome, 1 a flat plate with bevelled edges
uniform float whole;        // mosaic: 1 a cell the picture's edge cuts is left out, so the outline is whole cells
uniform float4 open_edge;   // mosaic, whole cells: 1 for a side (left, top, right, bottom) that is no edge (the screen's edge cuts it there anyway)
uniform float fallback;     // mosaic: 1 the picture is kept to a mask (alpha), so a cell reaches further for a colour
uniform float keep_alpha;   // MaskedComposite: the blur gives colour only; the alpha is the picture's own
uniform float bloom_threshold;  // BloomBright: how bright a part must be to shine, 0..1
uniform float bloom_amount;     // BloomAdd: how strongly the light is laid over
uniform texture2d original;     // MaskedComposite: the picture as it was
uniform texture2d mask;         // MaskedComposite: where the blur goes (red, 0..1)
uniform float mix_amount;       // MaskedComposite: how much of the blur, 0..1
uniform float counted;          // MaskPiece: 1 the piece is blurred, 0 it is kept clear
uniform float lift_level;       // Lift: how bright black becomes (0..1: the image's share, or the colour's luminance)
uniform float4 lift_color;      // Lift: the colour a dark part is lifted toward
uniform float lift_image;       // Lift: 1 lift toward image2 (the background image alone), 0 toward lift_color
uniform float2 rect_in_size;    // RectFirst / RectReduce: the picture (or rectangles) read, in texels

sampler_state linearClamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

sampler_state rectPoint {
	Filter   = Point;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float4 tap(float2 uv)
{
	return image.SampleLevel(linearClamp, uv, 0.0);
}

// sum.rgb holds colour * alpha * weight, sum.a holds alpha * weight.
float4 resolve(float4 sum, float wsum)
{
	return float4(sum.rgb / max(sum.a, 0.00001), sum.a / max(wsum, 0.00001));
}

// ------------------------------------------------------------------ Mosaic
// The picture cut into cells of one shape; each cell takes the colour of the
// picture at its centre. `strength` is the cell size: every shape is sized so
// that its cells cover about strength x strength pixels.

float2 hash2(float2 c)
{
	float2 k = float2(dot(c, float2(127.1, 311.7)), dot(c, float2(269.5, 183.3)));
	return frac(sin(k) * 43758.5453);
}

// Two offset rectangular grids; the nearer cell centre wins, which carves
// the plane into hexagons whose centres are `block` apart.
float2 hex_centre(float2 p, float block)
{
	float2 step_size = float2(1.7320508, 1.0) * block;
	float2 half_step = step_size * 0.5;
	float2 a = p - step_size * floor(p / step_size) - half_step;
	float2 moved = p - half_step;
	float2 b = moved - step_size * floor(moved / step_size) - half_step;
	float2 nearest = lerp(b, a, step(dot(a, a), dot(b, b)));
	return p - nearest;
}

// Circles packed like the hexagons. The gap between three circles is a cell
// of its own, centred on the hexagon corner in the middle of it.
float2 circle_centre(float2 p, float block)
{
	float2 c = hex_centre(p, block);
	float2 d = p - c;
	float2 best = c;
	float best_d = 1.0e20;
	for (int i = 0; i < 6; i++) {
		float ang = float(i) * 1.0471976;
		float2 corner = c + float2(cos(ang), sin(ang)) * block * 0.57735027;
		float2 e = p - corner;
		float dd = dot(e, e);
		if (dd < best_d) {
			best_d = dd;
			best = corner;
		}
	}
	float inside = step(dot(d, d), block * block * 0.25);
	return lerp(best, c, inside);
}

// A grid of equilateral triangles is a grid of slanted squares, each cut in
// two. These go to and from that slanted grid.
float2 to_slanted(float2 p, float side)
{
	float v = p.y / (side * 0.8660254);
	return float2(p.x / side - v * 0.5, v);
}

float2 from_slanted(float2 l, float side)
{
	return float2((l.x + l.y * 0.5) * side, l.y * side * 0.8660254);
}

float2 triangle_centre(float2 p, float side)
{
	float2 l = to_slanted(p, side);
	float2 i = floor(l);
	float2 f = l - i;
	float upper = step(1.0, f.x + f.y);
	float third = lerp(0.33333333, 0.66666667, upper);
	return from_slanted(i + float2(third, third), side);
}

float2 rhomboid_centre(float2 p, float side)
{
	float2 l = to_slanted(p, side);
	return from_slanted(floor(l) + float2(0.5, 0.5), side);
}

// Each triangle cut in three from its middle to its corners.
float2 triakis_centre(float2 p, float side)
{
	float2 l = to_slanted(p, side);
	float2 i = floor(l);
	float2 f = l - i;
	float upper = step(1.0, f.x + f.y);
	float2 g = lerp(f, float2(1.0, 1.0) - f, upper);
	float2 v0 = i + float2(upper, upper);
	float2 v1 = i + lerp(float2(1.0, 0.0), float2(0.0, 1.0), upper);
	float2 v2 = i + lerp(float2(0.0, 1.0), float2(1.0, 0.0), upper);
	float b0 = 1.0 - g.x - g.y;
	float b1 = g.x;
	float b2 = g.y;
	float2 middle = (v0 + v1 + v2) / 3.0;
	// The third it is in lies across from the corner it is furthest from.
	float2 part = (middle + v1 + v2) / 3.0;
	if (b1 < b0 && b1 <= b2)
		part = (middle + v0 + v2) / 3.0;
	if (b2 < b0 && b2 < b1)
		part = (middle + v0 + v1) / 3.0;
	return from_slanted(part, side);
}

// One point at a chance place in every square; the nearest point's cell.
float2 voronoi_centre(float2 p, float block)
{
	float2 q = p / block;
	float2 i = floor(q);
	float2 best = i;
	float best_d = 1.0e20;
	for (int y = 0; y < 3; y++) {
		for (int x = 0; x < 3; x++) {
			float2 n = i + float2(float(x) - 1.0, float(y) - 1.0);
			float2 point_at = n + hash2(n);
			float2 e = q - point_at;
			float dd = dot(e, e);
			if (dd < best_d) {
				best_d = dd;
				best = point_at;
			}
		}
	}
	return best * block;
}

float2 cell_centre(float2 p, float block)
{
	float2 c = (floor(p / block) + float2(0.5, 0.5)) * block;
	if (shape > 5.5)
		c = triakis_centre(p, block * 2.63);
	else if (shape > 4.5)
		c = rhomboid_centre(p, block * 1.075);
	else if (shape > 3.5)
		c = voronoi_centre(p, block);
	else if (shape > 2.5)
		c = triangle_centre(p, block * 1.52);
	else if (shape > 1.5)
		c = circle_centre(p, block);
	else if (shape > 0.5)
		c = hex_centre(p, block);
	return c;
}

// ------------------------------------------------------------ whole cells
// "Whole cells": a cell that the picture's edge cuts is left out, so that
// what is left is made of whole cells and its outline (the image's alpha)
// follows them. A cell can only be left out, never drawn past the edge: the
// picture cannot grow. A point of the pattern (`v`, in the pattern's own
// turned space, as `p` is) is judged by how far inside the picture's edges it
// lies once turned back: below 0 it is outside.

float inside_by(float2 v)
{
	float2 back = float2(v.x * turn.x - v.y * turn.y, v.x * turn.y + v.y * turn.x) + origin;
	// (A side that is open is never reached.)
	float4 d = float4(back.x, back.y, size.x - back.x, size.y - back.y) + open_edge * 1.0e6;
	return min(min(d.x, d.y), min(d.z, d.w));
}

// The least of inside_by over the corners of a triangle or a rhomboid of the
// slanted grid (`side` long), given in slanted units.
float inside_slanted(float2 a, float2 b, float2 c, float side)
{
	return min(inside_by(from_slanted(a, side)), min(inside_by(from_slanted(b, side)), inside_by(from_slanted(c, side))));
}

// A picture corner (in pixels, `k` 0..3 round it, half a pixel outside) in
// the pattern's turned space, in cells.
float2 corner_in_cells(float k, float block)
{
	float2 at = float2(-0.5, -0.5);
	if (k > 2.5)
		at = float2(-0.5, size.y + 0.5);
	else if (k > 1.5)
		at = size + float2(0.5, 0.5);
	else if (k > 0.5)
		at = float2(size.x + 0.5, -0.5);
	float2 d = at - origin;
	return float2(d.x * turn.x + d.y * turn.y, d.y * turn.x - d.x * turn.y) / block;
}

// Whether the Voronoi cell of the point `s` (in cells) reaches the line
// through `a` along `u`: the points of the line nearer `s` than every other
// point near it (the 24 round it, as voronoi_centre places them) are a
// stretch of it, worked out side by side. 1 when that stretch is not empty.
float voronoi_reaches(float2 s, float2 a, float2 u)
{
	float2 i = floor(s);
	float lo = -1.0e20;
	float hi = 1.0e20;
	float none = 0.0;
	for (int y = 0; y < 5; y++) {
		for (int x = 0; x < 5; x++) {
			float2 n = i + float2(float(x) - 2.0, float(y) - 2.0);
			float2 other = n + hash2(n);
			float2 e = other - s;
			if (dot(e, e) > 0.000001) {
				// Nearer `s` than `other` where t * k1 <= k0.
				float k1 = 2.0 * dot(u, e);
				float k0 = dot(other, other) - dot(s, s) - 2.0 * dot(a, e);
				if (k1 > 0.000001)
					hi = min(hi, k0 / k1);
				else if (k1 < -0.000001)
					lo = max(lo, k0 / k1);
				else if (k0 < 0.0)
					none = 1.0;
			}
		}
	}
	return (1.0 - none) * step(lo, hi);
}

// 1 when the Voronoi cell of `c` (in pixels) lies wholly on the picture:
// its point is on it and the cell reaches none of its four edges' lines.
// Only a cell near an edge is worked out.
float voronoi_whole(float2 c, float block)
{
	if (inside_by(c) < -0.5)
		return 0.0;
	if (inside_by(c) > block * 1.4143)
		return 1.0;
	float2 s = c / block;
	float reach = 0.0;
	for (int k = 0; k < 4; k++) {
		float2 a = corner_in_cells(float(k), block);
		float2 b = corner_in_cells(float(k) + 1.0 - step(2.5, float(k)) * 4.0, block);
		// Edges 0 to 3: top, right, bottom, left. An open one is no edge.
		float side_open = open_edge.y;
		if (k == 1)
			side_open = open_edge.z;
		else if (k == 2)
			side_open = open_edge.w;
		else if (k == 3)
			side_open = open_edge.x;
		reach = max(reach, voronoi_reaches(s, a, b - a) * (1.0 - step(0.5, side_open)));
	}
	return 1.0 - reach;
}

// 1 when the cell whose centre is `c` (from cell_centre) lies wholly on the
// picture, else 0. Each shape is judged by its own corners, a circle by its
// radius, a Voronoi cell by its neighbours.
float cell_whole(float2 c, float block)
{
	float least = 0.0;
	if (shape > 5.5) {
		float side = block * 2.63;
		float2 l = to_slanted(c, side);
		float2 i = floor(l);
		float2 f = l - i;
		float upper = step(1.0, f.x + f.y);
		float2 v0 = i + float2(upper, upper);
		float2 v1 = i + lerp(float2(1.0, 0.0), float2(0.0, 1.0), upper);
		float2 v2 = i + lerp(float2(0.0, 1.0), float2(1.0, 0.0), upper);
		float2 middle = (v0 + v1 + v2) / 3.0;
		// The third is the middle and the two corners nearer its centre.
		float d0 = dot(l - v0, l - v0);
		float d1 = dot(l - v1, l - v1);
		float d2 = dot(l - v2, l - v2);
		least = inside_slanted(middle, v1, v2, side);
		if (d1 > d0 && d1 >= d2)
			least = inside_slanted(middle, v0, v2, side);
		if (d2 > d0 && d2 > d1)
			least = inside_slanted(middle, v0, v1, side);
	} else if (shape > 4.5) {
		float side = block * 1.075;
		float2 i = floor(to_slanted(c, side));
		least = min(inside_slanted(i, i + float2(1.0, 0.0), i + float2(0.0, 1.0), side),
			    inside_by(from_slanted(i + float2(1.0, 1.0), side)));
	} else if (shape > 3.5) {
		least = voronoi_whole(c, block) - 0.75;
	} else if (shape > 2.5) {
		float side = block * 1.52;
		float2 l = to_slanted(c, side);
		float2 i = floor(l);
		float2 f = l - i;
		float upper = step(1.0, f.x + f.y);
		least = inside_slanted(i + float2(upper, upper), i + float2(1.0, 0.0), i + float2(0.0, 1.0), side);
	} else if (shape > 1.5) {
		// A circle (its centre a hexagon's) or the gap between three.
		float2 h = hex_centre(c, block);
		float is_round = step(length(c - h), block * 0.1);
		least = inside_by(c) - lerp(0.29, 0.5, is_round) * block;
	} else if (shape > 0.5) {
		float r = block * 0.57735027;
		float x = r * 0.5;
		float y = r * 0.8660254;
		least = min(min(inside_by(c + float2(r, 0.0)), inside_by(c - float2(r, 0.0))),
			    min(min(inside_by(c + float2(x, y)), inside_by(c + float2(x, -y))),
				min(inside_by(c + float2(-x, y)), inside_by(c - float2(x, y)))));
	} else {
		float e = block * 0.5;
		least = min(min(inside_by(c + float2(e, e)), inside_by(c + float2(e, -e))),
			    min(inside_by(c + float2(-e, e)), inside_by(c - float2(e, e))));
	}
	// (Half a pixel of slack: a cell flush with the edge is whole.)
	return step(-0.5, least);
}

// Where to read the colour of the cell that `p + o * smoothing` lies in (a
// little off the cell's centre, towards `o`, so that nine of these together
// are the cell's colour and, with smoothing, a soft edge between cells), as
// a place in the picture (xy, in uv), and whether the cell is kept (z: a cell
// left out by "whole cells" gives nothing, so smoothing fades into it).
float4 mosaic_tap(float2 p, float2 o, float block)
{
	float2 cell = cell_centre(p + o * smoothing, block);
	float keep = 1.0;
	if (whole > 0.5)
		keep = cell_whole(cell, block);
	float2 c = cell + o * block * 0.2;
	float2 back = float2(c.x * turn.x - c.y * turn.y, c.x * turn.y + c.y * turn.x) + origin;
	return float4(back * texel, keep, 0.0);
}

float4 PSMosaic(VertData v_in) : TARGET
{
	float block = max(strength, 1.0);
	float2 d = v_in.uv * size - origin;
	float2 p = float2(d.x * turn.x + d.y * turn.y, d.y * turn.x - d.x * turn.y);

	// The cell's centre and the eight round it, in one loop (written out
	// nine times, the whole-cells test made the shader too long to compile
	// comfortably).
	float4 sum = float4(0.0, 0.0, 0.0, 0.0);
	for (int k = 0; k < 9; k++) {
		float row = floor(float(k) / 3.0);
		float4 at = mosaic_tap(p, float2(float(k) - row * 3.0 - 1.0, row - 1.0), block);
		float4 s = tap(at.xy);
		sum += float4(s.rgb * s.a, s.a) * at.z;
	}
	// Scene Blur gives a picture whose alpha is kept to the blurred sources
	// (`fallback`), so a cell only takes in what lies inside them. A cell
	// whose taps near its centre all lie outside (it only just reaches in)
	// looks further out, on a ring round its centre, and failing that takes
	// the pixel's own colour: never anything from outside.
	if (fallback > 0.5 && sum.a < 0.001) {
		float2 centre = cell_centre(p, block);
		for (int r = 0; r < 8; r++) {
			float ang = float(r) * 0.78539816;
			float2 c = centre + float2(cos(ang), sin(ang)) * block * 0.42;
			float2 back = float2(c.x * turn.x - c.y * turn.y, c.x * turn.y + c.y * turn.x) + origin;
			float4 s = tap(back * texel);
			sum += float4(s.rgb * s.a, s.a);
		}
		if (sum.a < 0.001) {
			float4 own = tap(v_in.uv);
			sum = float4(own.rgb * own.a, own.a);
		}
	}
	float4 colour = resolve(sum, 9.0);
	// Glass: each cell is lit from the upper left like a small pane, brighter
	// towards the light, darker away from it, with a glint and a dark rim.
	// One more look at which cell this is; nothing more is read.
	if (glass > 0.001) {
		float2 q = (p - cell_centre(p, block)) / block;
		float2 light = float2(-0.62, -0.78);
		float3 lit = colour.rgb;
		if (glass_style > 0.5) {
			// A flat plate: the face is left as it is, and a narrow, sharp
			// bevel runs along the cell's edges, each facet lit as one,
			// bright where it faces the light and dark where it faces away.
			// Squares and hexagons have straight facets; the other shapes
			// are taken as round.
			float2 n = q / max(length(q), 0.001);
			float far = length(q) * 2.0;
			if (shape < 0.5) {
				n = float2(0.0, sign(q.y));
				if (abs(q.x) > abs(q.y))
					n = float2(sign(q.x), 0.0);
				far = max(abs(q.x), abs(q.y)) * 2.0;
			} else if (shape < 1.5) {
				float a1 = 0.8660254 * q.x + 0.5 * q.y;
				float a2 = 0.8660254 * q.x - 0.5 * q.y;
				n = float2(0.0, sign(q.y));
				far = abs(q.y);
				if (abs(a1) > far) {
					far = abs(a1);
					n = float2(0.8660254, 0.5) * sign(a1);
				}
				if (abs(a2) > far) {
					far = abs(a2);
					n = float2(0.8660254, -0.5) * sign(a2);
				}
				far = far * 2.0;
			}
			float band = clamp((far - 0.8) * 30.0, 0.0, 1.0);
			float side = dot(n, light);
			lit = lit * (1.0 + glass * band * 0.6 * side);
			lit += float3(1.0, 1.0, 1.0) * (glass * 0.4 * band * clamp(side, 0.0, 1.0));
		} else {
			// A dome: the whole cell leans towards the light like a bead of
			// glass, with a glint and a darker rim.
			float lean = clamp(dot(q, light) * 1.6, -1.0, 1.0);
			float2 away = q - light * 0.2;
			float glint = clamp(1.0 - dot(away, away) * 22.0, 0.0, 1.0);
			glint = glint * glint * glint;
			float rim = clamp((dot(q, q) - 0.16) * 7.0, 0.0, 1.0);
			lit = lit * (1.0 + glass * (0.45 * lean - 0.4 * rim));
			lit += float3(1.0, 1.0, 1.0) * (glass * 0.55 * glint);
		}
		colour.rgb = clamp(lit, 0.0, 1.0);
	}
	return colour;
}

// ---------------------------------------------------------------- Temporal
// The picture mixed with what this pass drew last time (`image2`): `mix2` of
// the old stays. Premultiplied while mixing, straight alpha out.

float4 PSTemporal(VertData v_in) : TARGET
{
	float4 now = image.Sample(linearClamp, v_in.uv);
	float4 was = image2.Sample(linearClamp, v_in.uv);
	float4 m = lerp(float4(now.rgb * now.a, now.a), float4(was.rgb * was.a, was.a), mix2);
	return float4(m.rgb / max(m.a, 0.00001), m.a);
}

// ------------------------------------------------------------------- Bloom

// The parts of the picture bright enough to shine: all of a part well above
// the threshold, none of one well below it.
float4 PSBloomBright(VertData v_in) : TARGET
{
	float3 rgb = image.Sample(linearClamp, v_in.uv).rgb;
	float top = max(rgb.r, max(rgb.g, rgb.b));
	float shine = smoothstep(bloom_threshold - 0.1, bloom_threshold + 0.1, top);
	return float4(rgb * shine, 1.0);
}

// That light (`image2`, spread out by a blur) laid over the picture the way
// light adds up: it brightens, and never past white.
float4 PSBloomAdd(VertData v_in) : TARGET
{
	float3 rgb = image.Sample(linearClamp, v_in.uv).rgb;
	float3 light = saturate(image2.Sample(linearClamp, v_in.uv).rgb * bloom_amount);
	float3 with_light = float3(1.0, 1.0, 1.0) - (float3(1.0, 1.0, 1.0) - rgb) * (float3(1.0, 1.0, 1.0) - light);
	return float4(with_light, 1.0);
}

// The other bloom: the whole picture's light (`image2`, spread out) added to
// the picture, as obs-shaderfilter's bloom shader does it. It brightens
// everything and runs into white.
float4 PSBloomAmplify(VertData v_in) : TARGET
{
	float3 rgb = image.Sample(linearClamp, v_in.uv).rgb;
	float3 light = image2.Sample(linearClamp, v_in.uv).rgb * bloom_amount;
	return float4(saturate(rgb + light), 1.0);
}

// -------------------------------------------------------------------- Lift
// Ambient Background's Darkest level, on the picture as it is put together
// (the background image with the capture over it), before the blur: the
// blur, the mosaic, the trail and bloom then act on the lifted picture, so
// the lift is as soft as the rest and a mosaic cell is one colour.
//
// The floor is the fill at the level: toward the image (image2, the image
// alone, drawn where the picture has it), the image times the level, so 1 %
// barely shows it and 100 % is the image itself; toward a colour, the colour
// as bright as the level. A part's brightness becomes a smooth maximum of
// its own and the floor's (quadratic, as wide as the floor is bright):
// black is the floor exactly, a part twice as bright as the floor or more
// is left as it is, and in between the brightness rises smoothly and never
// falls (no band, no edge). Toward the image the knee is never so wide
// that it reaches the image's own brightness there (min(floor, image -
// floor)): above 50 % a knee as wide as the floor would brighten the image
// itself, by a quarter at 100 %. So a part that is the image is left as it
// is at every level, and 100 % is max(part, image). What is added is the
// floor's own colour, never a change to the part's: its bright parts keep
// their hue. Raw (non-linear) values, like the passes round it. Every
// uniform it reads: image, image2, lift_level, lift_color, lift_image.

float lift_luma(float3 c)
{
	return dot(c, float3(0.2126, 0.7152, 0.0722));
}

float4 PSLift(VertData v_in) : TARGET
{
	float4 px = image.Sample(linearClamp, v_in.uv);
	float3 img = image2.Sample(linearClamp, v_in.uv).rgb;

	// The colour as bright as the level. (A very saturated colour runs into
	// its channel's top: grey makes up the rest.)
	float cl = lift_luma(lift_color.rgb);
	float3 tint = cl > 0.004 ? lift_color.rgb / cl : float3(1.0, 1.0, 1.0);
	float3 coloured = saturate(tint * lift_level);
	coloured = saturate(coloured + float3(1.0, 1.0, 1.0) * max(lift_level - lift_luma(coloured), 0.0));
	float3 floor_rgb = lerp(coloured, img * lift_level, lift_image);

	float l = lift_luma(px.rgb);
	float lf = lift_luma(floor_rgb);
	// The knee: as wide as the floor is bright; toward the image, never up
	// to the image's own brightness (0 at 100 %: a plain maximum there).
	float knee = lerp(lf, max(min(lf, lift_luma(img) - lf), 0.0), lift_image);
	float h = saturate(1.0 - abs(l - lf) / max(knee, 0.00001));
	float soft_max = max(l, lf) + knee * h * h * 0.25;
	float g = saturate((soft_max - l) / max(lf, 0.00001));
	return float4(saturate(px.rgb + floor_rgb * g), px.a);
}

// -------------------------------------------------------------- Scene Blur
// One piece of a scene's mask: an item's own picture, drawn over the mask
// from the top of the scene down ("under" blending), as its coverage in red
// where it is blurred and as nothing where it is kept clear. What is left in
// red at the end is how much of each pixel shows a blurred source.

float4 PSMaskPiece(VertData v_in) : TARGET
{
	float a = image.Sample(linearClamp, v_in.uv).a;
	return float4(a * counted, a * counted, a * counted, a);
}

// The blurred picture (`image`, `image2` mixed by `mix2`, straight alpha, as
// the blur leaves it) laid over the picture as it was, only where the mask
// says, times `mix_amount`. Premultiplied while mixing, straight alpha out.
float4 PSMaskedComposite(VertData v_in) : TARGET
{
	float4 o = original.Sample(linearClamp, v_in.uv);
	float4 b1 = image.Sample(linearClamp, v_in.uv);
	float4 b2 = image2.Sample(linearClamp, v_in.uv);
	float4 b = lerp(float4(b1.rgb * b1.a, b1.a), float4(b2.rgb * b2.a, b2.a), mix2);
	// The blur of a picture kept to the blurred sources: its colour, with
	// the picture's own alpha (its alpha is how much of them it took in).
	if (keep_alpha > 0.5) {
		float3 colour = b.rgb / max(b.a, 0.00001);
		b = lerp(float4(o.rgb * o.a, o.a), float4(colour * o.a, o.a), step(0.0001, b.a));
	}
	float k = saturate(mask.Sample(linearClamp, v_in.uv).r) * mix_amount;
	float4 m = lerp(float4(o.rgb * o.a, o.a), b, k);
	return float4(m.rgb / max(m.a, 0.00001), m.a);
}

// A picture kept to the blurred sources: its colour, and its alpha times the
// mask (red), so a blur averages only what lies inside them.
float4 PSKeepToMask(VertData v_in) : TARGET
{
	float4 c = image.Sample(linearClamp, v_in.uv);
	return float4(c.rgb, c.a * saturate(mask.Sample(linearClamp, v_in.uv).r));
}

technique KeepToMask
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSKeepToMask(v_in);
	}
}

technique MaskPiece
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMaskPiece(v_in);
	}
}

technique MaskedComposite
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMaskedComposite(v_in);
	}
}

technique BloomAmplify
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBloomAmplify(v_in);
	}
}

technique Mosaic
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMosaic(v_in);
	}
}

technique Temporal
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSTemporal(v_in);
	}
}

technique BloomBright
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBloomBright(v_in);
	}
}

technique BloomAdd
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBloomAdd(v_in);
	}
}

technique Lift
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSLift(v_in);
	}
}

// The rectangle a picture's visible pixels (alpha at least a half) cover,
// found on the graphics card without reading anything back: RectFirst gives
// each block of 8 by 8 pixels its rectangle (x0, y0, x1, y1 in pixels, x1
// and y1 past the last; an empty block is 1e9, 1e9, -1e9, -1e9), RectReduce
// joins blocks of 8 by 8 of those, down to one. For a Scene Shadow or Shadow,
// Glow & Outline line round the drawn picture: a source's box can hold
// see-through margins (a widget's, a capture's), and a line round the box
// stood off the picture on those sides.
float4 PSRectFirst(VertData v_in) : TARGET
{
	float2 blocks = ceil(rect_in_size / 8.0);
	float2 base = floor(v_in.uv * blocks) * 8.0;
	float4 r = float4(1e9, 1e9, -1e9, -1e9);
	for (int j = 0; j < 8; j++) {
		for (int i = 0; i < 8; i++) {
			float2 t = base + float2(float(i), float(j));
			float inside = step(t.x + 0.5, rect_in_size.x) * step(t.y + 0.5, rect_in_size.y);
			float a = image.SampleLevel(rectPoint, (t + 0.5) / rect_in_size, 0).a;
			float on = inside * step(0.5, a);
			r = lerp(r, float4(min(r.xy, t), max(r.zw, t + 1.0)), on);
		}
	}
	return r;
}

float4 PSRectReduce(VertData v_in) : TARGET
{
	float2 blocks = ceil(rect_in_size / 8.0);
	float2 base = floor(v_in.uv * blocks) * 8.0;
	float4 r = float4(1e9, 1e9, -1e9, -1e9);
	for (int j = 0; j < 8; j++) {
		for (int i = 0; i < 8; i++) {
			float2 t = base + float2(float(i), float(j));
			float inside = step(t.x + 0.5, rect_in_size.x) * step(t.y + 0.5, rect_in_size.y);
			float4 c = image.SampleLevel(rectPoint, (t + 0.5) / rect_in_size, 0);
			r = lerp(r, float4(min(r.xy, c.xy), max(r.zw, c.zw)), inside);
		}
	}
	return r;
}

technique RectFirst
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSRectFirst(v_in);
	}
}

technique RectReduce
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSRectReduce(v_in);
	}
}
