{
	"extends": "@tsconfig/node20/tsconfig.json",
	"compilerOptions": {
		"customConditions": ["node"],
		"module": "ESNext",
		"resolveJsonModule": true,
		"moduleResolution": "Bundler",
		"noImplicitOverride": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
