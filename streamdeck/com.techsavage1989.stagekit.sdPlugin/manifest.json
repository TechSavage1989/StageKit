{
	"Name": "StageKit",
	"Version": "0.3.0.0",
	"Author": "StageKit contributors",
	"Actions": [
		{
			"Name": "Filter switch",
			"UUID": "com.techsavage1989.stagekit.switch",
			"Icon": "imgs/actions/switch/icon",
			"Tooltip": "Switches a StageKit filter on and off. The key shows which way it is.",
			"PropertyInspectorPath": "ui/switch.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/switch/off",
					"Name": "Off",
					"TitleAlignment": "bottom"
				},
				{
					"Image": "imgs/actions/switch/on",
					"Name": "On",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Move",
			"UUID": "com.techsavage1989.stagekit.move",
			"Icon": "imgs/actions/move/icon",
			"Tooltip": "Runs a StageKit move: Send To, Place Item, Layout or a Picture Shape key.",
			"PropertyInspectorPath": "ui/move.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/move/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Arrange tool",
			"UUID": "com.techsavage1989.stagekit.tool",
			"Icon": "imgs/actions/tool/icon",
			"Tooltip": "Lines up, spaces out, snaps or resizes the items selected in OBS, or copies a transform to other scenes.",
			"PropertyInspectorPath": "ui/tool.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/tool/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Blur everything",
			"UUID": "com.techsavage1989.stagekit.blurall",
			"Icon": "imgs/actions/blur/icon",
			"Tooltip": "Switches every Ramp Blur on, or all of them off again. Shows on while any is on.",
			"PropertyInspectorPath": "ui/blur-all.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/blur/off",
					"Name": "Off",
					"TitleAlignment": "bottom"
				},
				{
					"Image": "imgs/actions/blur/on",
					"Name": "On",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Hook capture",
			"UUID": "com.techsavage1989.stagekit.hook",
			"Icon": "imgs/actions/hook/icon",
			"Tooltip": "Makes a Game Capture or a Window Capture take the window or game that is in front right now.",
			"PropertyInspectorPath": "ui/hook.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/hook/key",
					"TitleAlignment": "bottom"
				}
			]
		}
	],
	"Category": "StageKit",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Keys for StageKit, the OBS Studio plugin: switch its filters on and off with the key showing which way they are, and run its camera moves. Talks to OBS through OBS's own WebSocket server.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.techsavage1989.stagekit"
